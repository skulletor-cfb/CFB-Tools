<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!--mirrors WebPageCreator/App.config so classes with static config-driven fields (e.g. Conference, ScheduledGame) can be constructed under the test host-->
    <add key="Power5" value="0,1,2,10,11"/>
    <add key="PowerInd" value="68"/>
    <add key="GameIdFwd" value="271=271"/>
    <add key="NeutralSiteGamesForRecords" value="271,272,276,273,{184;184}"/>
  </appSettings>
  <startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/></startup>
</configuration>
