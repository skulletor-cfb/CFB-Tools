<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- settings WebPageCreator types read in static initializers (Conference.PowerConferences); same values as WebPageCreator\App.config -->
  <appSettings>
    <add key="StartingYear" value="2013"/>
    <add key="Power5" value="0,1,2,10,11"/>
    <add key="PowerInd" value="68"/>
    <!-- ScheduledGame's static initializers -->
    <add key="GameIdFwd" value="271=271"/>
    <add key="NeutralSiteGamesForRecords" value="271,272,276,273,{184;184}"/>
    <add key="StadiumNickNameOverrides" value="Stadium=276,BeforeWeek=3,NickName=Chicago Kickoff;Stadium=184,BeforeWeek=2,NickName=Mile High Kickoff,RivalryGame=22-23+Rocky Mountain Showdown;"/>
  </appSettings>
</configuration>
