<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <ForceDesignerDpiUnaware>true</ForceDesignerDpiUnaware>
    <!-- the CFB Dynasty badge; also the window icon (Form1) -->
    <ApplicationIcon>dynasty.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FranchiseFile\FranchiseFile.csproj" />
    <!-- stadium names (CFBStadium) -->
    <ProjectReference Include="..\CFB27.Data.Model\CFB27.Data.Model.csproj" />
    <ProjectReference Include="..\NCAA14Utility\NCAA14Utility.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- the TV schedule page (Ctrl+V); {tvall} is replaced with the schedule json -->
    <EmbeddedResource Include="TV\tv-schedule.html" LogicalName="ScheduleMaker.TV.tv-schedule.html" />
  </ItemGroup>

</Project>